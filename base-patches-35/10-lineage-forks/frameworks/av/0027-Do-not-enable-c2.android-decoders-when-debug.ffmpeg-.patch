From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: SupeChicken666 <me@supechicken666.dev>
Date: Thu, 12 Feb 2026 13:10:46 +0800
Subject: [PATCH 27/27] Do not enable c2.android decoders when
 debug.ffmpeg-codec2.hwaccel.force=1

Signed-off-by: SupeChicken666 <me@supechicken666.dev>
---
 media/codec2/sfplugin/Codec2InfoBuilder.cpp | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/media/codec2/sfplugin/Codec2InfoBuilder.cpp b/media/codec2/sfplugin/Codec2InfoBuilder.cpp
index 8c8f9faa9..f5f43f483 100644
--- a/media/codec2/sfplugin/Codec2InfoBuilder.cpp
+++ b/media/codec2/sfplugin/Codec2InfoBuilder.cpp
@@ -431,6 +431,7 @@ status_t Codec2InfoBuilder::buildMediaCodecList(MediaCodecListWriter* writer) {
     // Codec2.0 software components have default rank 0x200.
     int option = ::android::base::GetIntProperty("debug.stagefright.ccodec", 4);
 
+    const bool force_hwaccel = ::android::base::GetBoolProperty("debug.ffmpeg-codec2.hwaccel.force", false);
     const std::string c2_pixfmt = ::android::base::GetProperty("debug.ffmpeg-codec2.pixel_format", "YUV_420");
 
     // Obtain Codec2Client
@@ -565,11 +566,11 @@ status_t Codec2InfoBuilder::buildMediaCodecList(MediaCodecListWriter* writer) {
             }
             std::string canonName = trait.name;
 
-            // Waydroid: Do not enable c2.android decoders on unsupported grallocs
+            // Waydroid: Do not enable c2.android video decoders on unsupported grallocs/when force_hwaccel is set
             if (hasPrefix(canonName, "c2.android.") &&
-                c2_pixfmt != "YUV_420" &&
                 trait.domain == C2Component::DOMAIN_VIDEO &&
-                trait.kind == C2Component::KIND_DECODER
+                trait.kind == C2Component::KIND_DECODER &&
+                (force_hwaccel || c2_pixfmt != "YUV_420")
             ) {
                 continue;
             }
