-cc_binary {
-    name: "android.hardware.health@2.0-service.waydroid",
-    init_rc: ["android.hardware.health@2.0-service.waydroid.rc"],
-    proprietary: true,
-    relative_install_path: "hw",
-    srcs: [
-        "health_service.cpp",
-    ],
-
-    cflags: [
-        "-Wall",
-        "-Werror",
-    ],
-
-    static_libs: [
-        "android.hardware.health@2.0-impl",
-        "android.hardware.health@1.0-convert",
-        "libhealthservice",
-        "libbatterymonitor",
-    ],
-
-    shared_libs: [
-        "libbase",
-        "libcutils",
-        "libhidlbase",
-        "libutils",
-        "android.hardware.health@2.0",
-    ],
-
-    header_libs: ["libhealthd_headers"],
-
-    overrides: [
-        "healthd",
-    ],
-}
diff --git a/health/android.hardware.health@2.0-service.waydroid.rc b/health/android.hardware.health@2.0-service.waydroid.rc
deleted file mode 100644
index 32768f8..0000000
--- a/health/android.hardware.health@2.0-service.waydroid.rc
