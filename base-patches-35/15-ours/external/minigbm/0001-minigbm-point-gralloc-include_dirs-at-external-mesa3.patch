From 97fbaac308394532a08c1c36cc7c07aea6daff7b Mon Sep 17 00:00:00 2001
From: minhmc2007 <quangminh21072010@gmail.com>
Date: Sun, 4 Oct 2026 10:12:52 +0700
Subject: [PATCH] minigbm: point gralloc include_dirs at external/mesa3d

error: external/minigbm/Android.bp:225:1: module "libminigbm_gralloc"
variant "android_vendor_x86_64_shared": source path "external/mesa/include"
does not exist

mesa3d is not swapped on Android 15, so the tree is LineageOS'
external/mesa3d and not the fork's external/mesa. Both include_dirs this
module needs exist under mesa3d, so only the path changes. These are the only
two references to external/mesa in any Android.bp or Android.mk in the tree.
---
 Android.bp | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/Android.bp b/Android.bp
index 17cd155..0807c67 100644
--- a/Android.bp
+++ b/Android.bp
@@ -227,8 +227,8 @@ cc_library_shared {
     defaults: ["minigbm_cros_gralloc_library_defaults"],
     include_dirs: [
         "external/libdrm/amdgpu",
-        "external/mesa/include",
-        "external/mesa/src/gallium/drivers/svga/include",
+        "external/mesa3d/include",
+        "external/mesa3d/src/gallium/drivers/svga/include",
     ],
     cflags: ["-DHAS_DMABUF_SYSTEM_HEAP"],
     arch: {
