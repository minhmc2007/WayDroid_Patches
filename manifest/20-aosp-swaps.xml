<?xml version="1.0" encoding="UTF-8"?>
<manifest>
  <!--
    OPT-IN, not installed by `waydroid-patches.sh manifest`. Pass with-aosp-swaps.

    repo cannot point an existing project at a different upstream. Verified in
    .repo/repo/manifest_xml.py: a second <project path="X"> is "duplicate path X"
    (recursively_add_projects, l.1452), and <extend-project> keeps the original
    project name so the fetch URL stays under platform/. So a swap is only
    expressible as <remove-project> + <project>, which is why upstream does the
    same.

    Keep this short. These five are AOSP-remote display/media trees that no ROM
    maintains, so losing LineageOS commits in them costs nothing. Swapping a
    LineageOS-maintained project would defeat the repo, since those are patched
    in place via 10-lineage-forks.

    22.2 swaps six: drm_hwcomposer and rust/ninja-to-soong from 23.2 are gone,
    gmmlib/media-driver move under hardware/intel/common/, and mesa3d is
    replaced by the fork at external/mesa.
  -->

  <!--
    mesa is a swap, not an addition. Upstream 22.2 adds the fork at
    external/mesa but never removes LineageOS' external/mesa3d, so both trees
    reach the module list and bootstrap dies with "module mesa_src_headers
    already defined" plus eight more.

    The fork has to win. device/waydroid/waydroid/BoardConfig.mk sets
    BOARD_MESA3D_USES_MESON_BUILD, and the fork's android/Android.mk is the
    only definition of libgbm_mesa, libEGL_mesa and libgallium_dri in the whole
    tree, all three of which device.mk puts in PRODUCT_PACKAGES. LineageOS'
    mesa3d has no src/gbm/Android.bp at all.

    This is the sixth remove-project, and it drops a LineageOS-maintained
    project, so it is a deliberate deviation from "never re-point LineageOS".
    Reverting it costs the GL stack: nothing else builds libgbm_mesa.
  -->
  <remove-project name="platform/external/mesa3d" />
  <project path="external/mesa" name="WayDroid-ATV/android_external_mesa3d" remote="ghub" clone-depth="1" revision="refs/heads/lineage-18.1" />

  <remove-project name="platform/external/minigbm" />
  <project path="external/minigbm" name="WayDroid-ATV/android_external_minigbm" remote="ghub" clone-depth="1" revision="refs/heads/lineage-21" />

  <remove-project name="platform/external/libdrm" />
  <project path="external/libdrm" name="WayDroid-ATV/android_external_libdrm" remote="ghub" clone-depth="1" revision="refs/heads/lineage-20" />

  <!--
    media-driver needs IGFX_NVL ids that LineageOS' gmmlib does not declare. Both
    trees expose libigdgmm_android with no soong_namespace, so syncing both fails
    bootstrap with "module already defined".

    Upstream points at projectceladon tags v22.8.0 and v25.2.6, but those tags no
    longer exist: projectceladon/gmmlib has only media_driver_rebase_2022_Q3 and
    projectceladon/media-driver has no tags at all. intel's trees are used
    instead, at the tags our Android 16 build already proved.
  -->
  <remove-project name="platform/external/gmmlib" />
  <project path="hardware/intel/common/gmmlib" name="intel/gmmlib" remote="ghub" clone-depth="1" revision="refs/tags/intel-gmmlib-22.10.0" />

  <remove-project name="platform/external/intel-media-driver" />
  <project path="hardware/intel/common/media-driver" name="intel/media-driver" remote="ghub" clone-depth="1" revision="refs/tags/intel-media-26.1.5" />

  <remove-project name="platform/external/libva" />
  <project path="hardware/intel/common/libva" name="WayDroid-ATV/hardware_intel_common_libva" remote="ghub" clone-depth="1" revision="refs/heads/14-x86" />

  <!--
    Uncomment only if android-crates-io proves to be the problem. LineageOS 22.2
    pins the android-15.0.0 tag, correct for SDK 35. Upstream 22.2 does not swap it.

  <remove-project name="platform/external/rust/android-crates-io" />
  <project path="external/rust/android-crates-io" name="WayDroid-ATV/android_external_rust_android-crates-io" remote="ghub" clone-depth="1" revision="refs/heads/android15-qpr2-release" />
  -->
</manifest>
