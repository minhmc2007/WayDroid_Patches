<?xml version="1.0" encoding="UTF-8"?>
<manifest>
  <!--
    ===========================================================================
    OPT-IN. Not installed by `./waydroid-patches.sh manifest`.
    Install with:  ./waydroid-patches.sh manifest <source-dir>
                  (option: with-aosp-swaps)

    WHY THIS FILE EXISTS
    `repo` has NO way to point an existing project at a different upstream
    repository. Verified against the manifest parser that ships with this
    checkout (.repo/repo/manifest_xml.py):

      * <project path="X" .../>            -> "duplicate path X"
                                            (recursively_add_projects, l.1452)
      * <extend-project name="..." remote=... revision=.../>
                                          -> allowed, but keeps the ORIGINAL
                                             project name, so the fetch URL
                                             becomes <fetch>/platform/external/<x>
                                             instead of the Waydroid fork.

    So swapping e.g. platform/external/mesa3d for
    WayDroid-ATV/android_external_mesa3d is only expressible as
    <remove-project> + <project>. There is no workaround inside the manifest
    format; this is why upstream WayDroid-ATV does exactly this too.

    SCOPE - keep this list as short as possible.
    These seven are the AOSP-remote display/media/rust trees. They are NOT
    LineageOS-maintained and essentially no custom ROM touches them, so losing
    upstream LineageOS commits in them costs nothing. Swapping any
    LineageOS-maintained project (frameworks/*, system/*, hardware/*, ...)
    would defeat the whole point of this repo - those are patched in place via
    base-patches-36/10-lineage-forks instead.
  ===========================================================================
  -->

  <!-- Display stack: Wayland/DRM/KMS for a container with no kernel modesetting -->
  <remove-project name="platform/external/drm_hwcomposer" />
  <project path="external/drm_hwcomposer" name="android-generic/external_drm_hwcomposer" remote="ghub" clone-depth="1" revision="refs/heads/main" />

  <remove-project name="platform/external/minigbm" />
  <project path="external/minigbm" name="WayDroid-ATV/android_external_minigbm" remote="ghub" clone-depth="1" revision="refs/heads/lineage-23.2" />

  <remove-project name="platform/external/mesa3d" />
  <project path="external/mesa3d" name="WayDroid-ATV/android_external_mesa3d" remote="ghub" clone-depth="1" revision="refs/heads/lineage-18.1" />

  <remove-project name="platform/external/libdrm" />
  <project path="external/libdrm" name="WayDroid-ATV/android_external_libdrm" remote="ghub" clone-depth="1" revision="refs/heads/lineage-20" />

  <!-- VA-API userspace -->
  <remove-project name="platform/external/libva" />
  <project path="external/libva" name="WayDroid-ATV/android_external_libva" remote="ghub" clone-depth="1" revision="refs/heads/14-x86" />

  <remove-project name="platform/external/libva-utils" />
  <project path="external/libva-utils" name="intel/libva-utils" remote="ghub" clone-depth="1" revision="refs/tags/2.23.0" />

  <!-- Rust build glue (waydroid builds hostbm via ninja, not Soong) -->
  <remove-project name="platform/external/rust/ninja-to-soong" />
  <project path="external/rust/ninja-to-soong" name="WayDroid-ATV/android_external_rust_ninja-to-soong" remote="ghub" clone-depth="1" revision="refs/heads/main" />

  <!--
    Optional. Uncomment ONLY if a build failure proves the LineageOS/AOSP
    android-crates-io is the problem - LineageOS already pins the
    android-16.0.0_r4 tag, which should be correct for SDK 36.

  <remove-project name="platform/external/rust/android-crates-io" />
  <project path="external/rust/android-crates-io" name="WayDroid-ATV/android_external_rust_android-crates-io" remote="ghub" clone-depth="1" revision="refs/heads/android16-qpr2-release" />
  -->
</manifest>
