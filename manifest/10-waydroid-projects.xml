<?xml version="1.0" encoding="UTF-8"?>
<manifest>
  <!--
    WayDroid ATV on LineageOS 22.2 / SDK 35, phone build.

    Mirrors upstream manifest_scripts/manifests-35/02-waydroid.xml at
    WayDroid-ATV/android_vendor_waydroid@lineage-22.2, minus the six projects
    upstream remove-projects and re-adds as forks. Those stay as the plain
    LineageOS checkout and are patched in place: frameworks/base, frameworks/av,
    frameworks/native, system/core, lineage-sdk, packages/apps/TvSettings. See
    base-patches-35/10-lineage-forks/.

    The five AOSP swaps upstream also does are in 20-aosp-swaps.xml, opt-in.
  -->

  <project path="device/waydroid/waydroid" name="WayDroid-ATV/android_device_waydroid_waydroid" remote="ghub" clone-depth="1" revision="refs/heads/lineage-22.2" />

  <!-- lineage-22.2 deleted upstream. lineage-21 and lineage-23.0 drop every HAL
     except audio/hwcomposer/interfaces, so gatekeeper, memtrack and power never
     register and the boot log crash-loops instead. -->
  <project path="hardware/waydroid" name="WayDroid-ATV/android_hardware_waydroid" remote="ghub" clone-depth="1" revision="refs/heads/fix_build_error" />
  <project path="vendor/extra" name="WayDroid-ATV/android_vendor_waydroid" remote="ghub" clone-depth="1" revision="refs/heads/lineage-22.2" />
  <project path="packages/apps/WaydroidUpdater" name="WayDroid/android_packages_apps_WaydroidUpdater" remote="ghub" clone-depth="1" revision="refs/heads/lineage-20" />

  <project path="external/alsa-lib" name="WayDroid-ATV/android_external_alsa-lib" remote="ghub" clone-depth="1" revision="refs/heads/lineage-20" />
  <project path="external/alsa-plugins" name="WayDroid-ATV/android_external_alsa-plugins" remote="ghub" clone-depth="1" revision="refs/heads/lineage-20" />
  <project path="external/libsndfile" name="WayDroid-ATV/android_external_libsndfile" remote="ghub" clone-depth="1" revision="refs/heads/lineage-20" />
  <project path="external/pulseaudio" name="WayDroid-ATV/android_external_pulseaudio" remote="ghub" clone-depth="1" revision="refs/heads/lineage-20" />

  <!-- mesa is a swap, not an addition. See 20-aosp-swaps.xml. -->
  <project path="external/hbm-prebuilts" name="android-generic/external_hbm-prebuilts" remote="ghub" clone-depth="1" revision="refs/heads/11" />
  <project path="hardware/intel/external/minigbm-intel" name="WayDroid-ATV/android_hardware_intel_external_minigbm-intel" remote="ghub" clone-depth="1" revision="refs/heads/celadon/a16/master" />

  <project path="external/llvm-project" name="WayDroid/android_external_llvm-project" remote="ghub" clone-depth="1" revision="refs/heads/lineage-18.1" />
  <project path="prebuilts/mesa-tools" name="WayDroid/android_prebuilts_mesa-tools" remote="ghub" groups="pdk" clone-depth="1" revision="refs/heads/main" />

  <project path="external/ffmpeg" name="WayDroid-ATV/android_external_ffmpeg" remote="ghub" clone-depth="1" revision="refs/heads/release/7.0-14" />
  <!-- 14-x86 was renamed upstream; this matches ffmpeg release/7.0-14 below -->
  <project path="external/stagefright-plugins" name="WayDroid-ATV/external_stagefright-plugins" remote="ghub" clone-depth="1" revision="refs/heads/14-x86/ffmpeg-7.0" />

  <project path="external/libva-utils" name="android-generic/external_libva-utils" remote="ghub" clone-depth="1" revision="refs/heads/14-x86" />
  <project path="hardware/intel/common/vaapi" name="WayDroid-ATV/platform_hardware_intel_common_vaapi" remote="ghub" clone-depth="1" revision="refs/heads/14-x86" />
  <project path="vendor/intel/mediasdk_c2" name="WayDroid-ATV/android_vendor_intel_mediasdk_c2" remote="ghub" clone-depth="1" revision="refs/heads/celadon/a16/master" />
  <project path="vendor/intel/external/onevpl" name="projectceladon/libvpl" remote="ghub" clone-depth="1" revision="refs/heads/celadon/a16/master" />
  <project path="vendor/intel/external/onevpl-gpu-rt" name="projectceladon/vpl-gpu-rt" remote="ghub" clone-depth="1" revision="refs/heads/celadon/a16/master" />

  <project path="vendor/google/proprietary/widevine-prebuilt" name="supremegamers/vendor_google_proprietary_widevine-prebuilt" remote="ghub" clone-depth="1" revision="refs/heads/celadon" />
  <project path="vendor/google/proprietary/ndk_translation-prebuilt" name="WayDroid-ATV/vendor_google_proprietary_ndk_translation-prebuilt" remote="ghub" clone-depth="1" revision="refs/heads/14arm_15arm64" />

  <!-- upstream names WayDroid-ATV/vendor_gapps@vic, but that repo is deleted.
       android_vendor_gapps@cinnamonbun is the Android 15 platform branch; there
       is no vendor/gapps_tv on this branch, 22.2 is a phone build. -->
  <project path="vendor/gapps" name="WayDroid-ATV/android_vendor_gapps" remote="ghub" clone-depth="1" revision="refs/heads/cinnamonbun" />

  <!--
    Not synced from a fork, LineageOS' own copy is kept:
      external/rust/android-crates-io - LineageOS 22.2 pins the android-15.0.0
        tag, which is what SDK 35 wants. Upstream 22.2 does not swap it.
      external/gmmlib, external/intel-media-driver, external/libdrm,
      external/libva, external/minigbm - upstream swaps these five, see
        20-aosp-swaps.xml.
  -->
</manifest>
