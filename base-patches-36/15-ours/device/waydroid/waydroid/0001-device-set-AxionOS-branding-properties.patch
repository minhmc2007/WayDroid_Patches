From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: minhmc2007 <quangminh21072010@gmail.com>
Date: Thu, 1 Oct 2026 14:32:29 +0700
Subject: [PATCH] device: set AxionOS branding properties

Sets AXION_MAINTAINER and AXION_PROCESSOR, which
device/axion/common/config/version.mk exports as
persist.sys.axion_maintainer and persist.sys.axion_cpu_info. About phone
reads the maintainer through BannerPreferenceController.kt, which
replaces "_" with " ".

Placed above the PRODUCT_IS_ATV branch so the values are set before the
inherit-product chain that reaches version.mk evaluates them. Both the
TV and the tablet inherit path reach it: common_full_tv.mk ->
common_tv.mk -> common.mk -> defaults_common.mk, and
common_full_tablet_wifionly.mk -> common_mobile_full.mk ->
common_mobile.mk -> common.mk -> defaults_common.mk.
---
 device.mk | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/device.mk b/device.mk
index dbcee30..aaa8589 100644
--- a/device.mk
+++ b/device.mk
@@ -14,6 +14,14 @@
 # limitations under the License.
 #
 
+# AxionOS branding. Read by device/axion/common/config/version.mk, which
+# exports them as persist.sys.axion_maintainer and persist.sys.axion_cpu_info
+# for "About phone". Must be set before the inherit-product chain below,
+# because that chain is what evaluates version.mk.
+# BannerPreferenceController.kt replaces "_" with " " when displaying them.
+AXION_MAINTAINER := minhmc2077
+AXION_PROCESSOR := Generic X86_64
+
 ifeq ($(PRODUCT_IS_ATV),true)
 # Inherit from atv products.
 $(call inherit-product, device/google/atv/products/atv_base.mk)
