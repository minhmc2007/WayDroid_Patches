From 738ea6afde0cfa6de0fd4fe967f202985bd4e03b Mon Sep 17 00:00:00 2001
From: minhmc2007 <quangminh21072010@gmail.com>
Date: Fri, 2 Oct 2026 13:13:56 +0700
Subject: [PATCH] device: set AxionOS branding properties

Sets AXION_MAINTAINER and AXION_PROCESSOR. AxionOS's own
device/axion/common/config/version.mk exports them as
persist.sys.axion_maintainer and persist.sys.axion_cpu_info, which About
phone reads through BannerPreferenceController.kt. That class replaces
"_" with " " when displaying them.

Placed above the PRODUCT_IS_ATV branch, because inherit-product is
deferred and both the TV and the tablet chain reach version.mk after
device.mk is parsed. Setting these lower down would leave them empty.
---
 device.mk | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/device.mk b/device.mk
index dbcee30..ea96038 100644
--- a/device.mk
+++ b/device.mk
@@ -14,6 +14,10 @@
 # limitations under the License.
 #
 
+# Read by device/axion/common/config/version.mk. Must precede the inherits.
+AXION_MAINTAINER := minhmc2077
+AXION_PROCESSOR := Generic X86_64
+
 ifeq ($(PRODUCT_IS_ATV),true)
 # Inherit from atv products.
 $(call inherit-product, device/google/atv/products/atv_base.mk)
-- 
