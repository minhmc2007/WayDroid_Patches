From ffbaca00657de0fcea8792112835c0d6a1796e1b Mon Sep 17 00:00:00 2001
From: minhmc2007 <quangminh21072010@gmail.com>
Date: Thu, 1 Oct 2026 15:23:47 +0700
Subject: [PATCH] device: disable arm64-only FaceUnlock off arm64

---
 device.mk | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/device.mk b/device.mk
index aaa8589..4cc249e 100644
--- a/device.mk
+++ b/device.mk
@@ -22,6 +22,11 @@
 AXION_MAINTAINER := minhmc2077
 AXION_PROCESSOR := Generic X86_64
 
+# FaceUnlock's Megvii prebuilts are android_arm64 only.
+ifneq ($(TARGET_ARCH),arm64)
+TARGET_FACE_UNLOCK_SUPPORTED := false
+endif
+
 ifeq ($(PRODUCT_IS_ATV),true)
 # Inherit from atv products.
 $(call inherit-product, device/google/atv/products/atv_base.mk)
