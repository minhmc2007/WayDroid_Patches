From a3f25e88ed72c2325bdcb40df39214256bfa3bf9 Mon Sep 17 00:00:00 2001
From: minhmc2007 <quangminh21072010@gmail.com>
Date: Thu, 1 Oct 2026 15:22:24 +0700
Subject: [PATCH] device: disable the arm64-only FaceUnlock prebuilts off arm64

FaceUnlock requires libFaceDetectCA, libMegviiUnlock,
libMegviiUnlock-jni-1.2 and libmegface_faceunlock, all four of which
declare only android_arm64 srcs in Android.bp. Soong emits no variant for
them on x86_64, so kati fails the build at "finishing Make module rules":

  TARGET module FaceUnlock requires non-existent TARGET module: libFaceDetectCA

device/axion/common/config/packages.mk inherits
packages/apps/FaceUnlock/common.mk, which skips FaceUnlock when
TARGET_FACE_UNLOCK_SUPPORTED is false. Set that off for any non-arm64
target, which leaves arm64 builds with face unlock intact.
---
 device.mk | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/device.mk b/device.mk
index aaa8589..3434694 100644
--- a/device.mk
+++ b/device.mk
@@ -22,6 +22,18 @@
 AXION_MAINTAINER := minhmc2077
 AXION_PROCESSOR := Generic X86_64
 
+# FaceUnlock requires four Megvii prebuilts -- libFaceDetectCA,
+# libMegviiUnlock, libMegviiUnlock-jni-1.2 and libmegface_faceunlock --
+# that declare only android_arm64 srcs. On any other arch Soong emits no
+# variant for them, so kati stops with
+#   TARGET module FaceUnlock requires non-existent TARGET module: libFaceDetectCA
+# device/axion/common/config/packages.mk pulls FaceUnlock in through
+# packages/apps/FaceUnlock/common.mk unless TARGET_FACE_UNLOCK_SUPPORTED is
+# false, so switch it off rather than let the build break.
+ifneq ($(TARGET_ARCH),arm64)
+TARGET_FACE_UNLOCK_SUPPORTED := false
+endif
+
 ifeq ($(PRODUCT_IS_ATV),true)
 # Inherit from atv products.
 $(call inherit-product, device/google/atv/products/atv_base.mk)
-- 
