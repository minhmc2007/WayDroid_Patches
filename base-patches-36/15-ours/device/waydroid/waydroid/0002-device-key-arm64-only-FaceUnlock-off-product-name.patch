From a5dacc1c3270661b7cf0a6afa5fa6feebd7e5f50 Mon Sep 17 00:00:00 2001
From: minhmc2007 <quangminh21072010@gmail.com>
Date: Thu, 1 Oct 2026 16:03:07 +0700
Subject: [PATCH] device: key arm64-only FaceUnlock off product name

---
 device.mk | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/device.mk b/device.mk
index 03ef3e7..a60a322 100644
--- a/device.mk
+++ b/device.mk
@@ -22,8 +22,9 @@
 AXION_MAINTAINER := minhmc2077
 AXION_PROCESSOR := Generic X86_64
 
-# FaceUnlock's Megvii prebuilts are android_arm64 only.
-ifneq ($(TARGET_ARCH),arm64)
+# FaceUnlock's Megvii prebuilts are android_arm64 only. TARGET_ARCH is still
+# empty here, so match on the product name instead.
+ifneq ($(TARGET_PRODUCT),$(filter lineage_waydroid_arm%,$(TARGET_PRODUCT)))
 override TARGET_FACE_UNLOCK_SUPPORTED := false
 endif
 
