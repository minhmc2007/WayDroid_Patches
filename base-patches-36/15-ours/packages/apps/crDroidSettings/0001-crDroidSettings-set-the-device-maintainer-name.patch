From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: minhmc2007 <quangminh21072010@gmail.com>
Date: Thu, 6 Oct 2026 15:25:00 +0700
Subject: [PATCH] fix(crDroidSettings): set the device maintainer name

Settings > About > Device maintainer read "Unofficial".

BuildMaintainerPreference fetches the name from the crDroid OTA server first and
only falls back to this string, so the name here sticks until a matching OTA
entry exists for this codename.
---
diff --git a/res/values/cr_strings.xml b/res/values/cr_strings.xml
index 332a5f4..7a8447f 100644
--- a/res/values/cr_strings.xml
+++ b/res/values/cr_strings.xml
@@ -1633,7 +1633,7 @@ A small donation helps keep this project alive and improving. You can dismiss th
 
     <!-- Build details -->
     <string name="build_maintainer_title">Device maintainer</string>
-    <string name="build_maintainer_summary">Unofficial</string>
+    <string name="build_maintainer_summary">Minhmc2077</string>
     <string name="build_maintainer_donate_url" translatable="false">https://crdroid.net/donate</string>
 
     <!-- Settings UI -->
