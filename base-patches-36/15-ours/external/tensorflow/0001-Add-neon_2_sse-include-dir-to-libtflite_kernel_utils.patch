From 20f3ca317e8656fb5510e8d279aaa986ccae948c Mon Sep 17 00:00:00 2001
From: minhmc2007 <quangminh21072010@gmail.com>
Date: Fri, 2 Oct 2026 05:53:21 +0700
Subject: [PATCH] Add neon_2_sse include dir to the tflite kernels that need it

Change-Id: Ic44cc70f55446d1b435e29a074f418ba51e2bcd1
---
 tensorflow/lite/kernels/Android.bp | 7 +++++++
 tensorflow/lite/tflite_static.bp   | 1 +
 2 files changed, 8 insertions(+)

diff --git a/tensorflow/lite/kernels/Android.bp b/tensorflow/lite/kernels/Android.bp
index ce5bf4d0..4c7bf6ef 100644
--- a/tensorflow/lite/kernels/Android.bp
+++ b/tensorflow/lite/kernels/Android.bp
@@ -190,6 +190,13 @@ cc_library_static {
     static_libs: [
         "libfft2d",
     ],
+    // internal/optimized/neon_check.h includes NEON_2_SSE.h on x86, which
+    // emulates the ARM intrinsics with SSE. Without this the x86_64 build
+    // fails in neon_tensor_utils.cc.
+    include_dirs: [
+        "external/gemmlowp",
+        "external/neon_2_sse",
+    ],
     cflags: [
         "-DNAMESPACE_FOR_HASH_FUNCTIONS=farmhash",
     ],
diff --git a/tensorflow/lite/tflite_static.bp b/tensorflow/lite/tflite_static.bp
index b2b0952f..dce5ebd8 100644
--- a/tensorflow/lite/tflite_static.bp
+++ b/tensorflow/lite/tflite_static.bp
@@ -219,6 +219,7 @@ cc_library_static {
         "external/flatbuffers/include",
         "external/gemmlowp",
         "external/libtextclassifier/native/",
+        "external/neon_2_sse",
         "external/tensorflow",
     ],
     whole_static_libs: [
-- 
2.55.0

