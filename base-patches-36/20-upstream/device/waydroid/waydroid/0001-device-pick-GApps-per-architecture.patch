index 5063a62..b663918 100644
--- a/waydroid_x86_64_only/lineage_waydroid_x86_64_only.mk
+++ b/waydroid_x86_64_only/lineage_waydroid_x86_64_only.mk
@@ -14,7 +14,7 @@
