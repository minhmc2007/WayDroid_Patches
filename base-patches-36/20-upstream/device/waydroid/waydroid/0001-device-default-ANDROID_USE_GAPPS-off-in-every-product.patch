+++ b/waydroid_tv_arm64/lineage_waydroid_tv_arm64.mk
@@ -17,7 +17,7 @@
 PRODUCT_IS_ATV := true
 TARGET_ATV_FORCE_1080_SCALING := false
 
-ANDROID_USE_GAPPS ?= true
+ANDROID_USE_GAPPS ?= false
 
 # Inherit from those products. Most specific first.
 $(call inherit-product, $(SRC_TARGET_DIR)/product/core_64_bit.mk)
diff --git a/waydroid_tv_arm64_only/lineage_waydroid_tv_arm64_only.mk b/waydroid_tv_arm64_only/lineage_waydroid_tv_arm64_only.mk
index 60a2ad4..8bcce7d 100644
--- a/waydroid_tv_arm64_only/lineage_waydroid_tv_arm64_only.mk
+++ b/waydroid_tv_arm64_only/lineage_waydroid_tv_arm64_only.mk
@@ -17,7 +17,7 @@
