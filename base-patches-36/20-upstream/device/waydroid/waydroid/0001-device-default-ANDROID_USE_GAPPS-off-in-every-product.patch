index 9d70255..c424d77 100644
--- a/waydroid_arm64_only/lineage_waydroid_arm64_only.mk
+++ b/waydroid_arm64_only/lineage_waydroid_arm64_only.mk
@@ -14,7 +14,7 @@
 # limitations under the License.
 #
 
-ANDROID_USE_GAPPS ?= true
+ANDROID_USE_GAPPS ?= false
 
 # Inherit from those products. Most specific first.
 $(call inherit-product, $(SRC_TARGET_DIR)/product/core_64_bit_only.mk)
diff --git a/waydroid_tv_arm/lineage_waydroid_tv_arm.mk b/waydroid_tv_arm/lineage_waydroid_tv_arm.mk
index e966bf0..28feac9 100644
--- a/waydroid_tv_arm/lineage_waydroid_tv_arm.mk
+++ b/waydroid_tv_arm/lineage_waydroid_tv_arm.mk
@@ -17,7 +17,7 @@
 PRODUCT_IS_ATV := true
 TARGET_ATV_FORCE_1080_SCALING := false
 
-ANDROID_USE_GAPPS ?= true
+ANDROID_USE_GAPPS ?= false
 
 # Inherit from waydroid device
 $(call inherit-product, $(LOCAL_PATH)/../device.mk)
