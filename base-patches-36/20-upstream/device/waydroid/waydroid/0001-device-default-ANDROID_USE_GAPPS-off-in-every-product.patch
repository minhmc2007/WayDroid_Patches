diff --git a/waydroid_x86_64/lineage_waydroid_x86_64.mk b/waydroid_x86_64/lineage_waydroid_x86_64.mk
index 927558f..07dc757 100644
--- a/waydroid_x86_64/lineage_waydroid_x86_64.mk
+++ b/waydroid_x86_64/lineage_waydroid_x86_64.mk
@@ -14,7 +14,7 @@
