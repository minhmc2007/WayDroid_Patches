From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: SupeChicken666 <me@supechicken666.dev>
Date: Sun, 20 Sep 2026 17:15:21 +0800
Subject: [PATCH 05/10] audio: Comment out Bluetooth HAL on manifest

We don't need it on Waydroid

Signed-off-by: SupeChicken666 <me@supechicken666.dev>
---
 audio/aidl/default/android.hardware.audio.service-aidl.xml | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/audio/aidl/default/android.hardware.audio.service-aidl.xml b/audio/aidl/default/android.hardware.audio.service-aidl.xml
index 26324a0de..261d8e6d4 100644
--- a/audio/aidl/default/android.hardware.audio.service-aidl.xml
+++ b/audio/aidl/default/android.hardware.audio.service-aidl.xml
@@ -12,14 +12,14 @@
   <hal format="aidl">
     <name>android.hardware.audio.core</name>
     <version>4</version>
-    <fqname>IModule/bluetooth</fqname>
+    <fqname>IConfig/default</fqname>
   </hal>
+  <!-- Uncomment when these modules present in the configuration
   <hal format="aidl">
     <name>android.hardware.audio.core</name>
     <version>4</version>
-    <fqname>IConfig/default</fqname>
+    <fqname>IModule/bluetooth</fqname>
   </hal>
-  <!-- Uncomment when these modules present in the configuration
   <hal format="aidl">
     <name>android.hardware.audio.core</name>
     <version>4</version>
