+class StreamPrimaryPulse : public StreamPulse {
+  public:
+    StreamPrimaryPulse(StreamContext* context, const Metadata& metadata);
+
+    // Methods of 'DriverInterface'.
+    ::android::status_t flush() override;
+    ::android::status_t start() override;
