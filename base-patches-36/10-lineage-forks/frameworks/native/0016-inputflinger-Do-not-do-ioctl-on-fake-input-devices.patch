From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: SupeChicken666 <me@supechicken666.dev>
Date: Mon, 13 Jul 2026 23:34:17 +0800
Subject: [PATCH 16/26] inputflinger: Do not do ioctl on fake input devices

Signed-off-by: SupeChicken666 <me@supechicken666.dev>
---
 services/inputflinger/reader/EventHub.cpp            | 12 +++++++-----
 .../accumulator/MultiTouchMotionAccumulator.cpp      |  2 +-
 2 files changed, 8 insertions(+), 6 deletions(-)

diff --git a/services/inputflinger/reader/EventHub.cpp b/services/inputflinger/reader/EventHub.cpp
index 1148186f4..b952f6711 100644
--- a/services/inputflinger/reader/EventHub.cpp
+++ b/services/inputflinger/reader/EventHub.cpp
@@ -662,11 +662,13 @@ bool EventHub::Device::configureFd() {
 }
 
 bool EventHub::Device::readDeviceState() {
-    if (readDeviceBitMask(EVIOCGKEY(0), keyState) < 0) {
-        ALOGD("Unable to query the global key state for %s: %s", path.c_str(), strerror(errno));
-    }
-    if (readDeviceBitMask(EVIOCGSW(0), swState) < 0) {
-        ALOGD("Unable to query the global switch state for %s: %s", path.c_str(), strerror(errno));
+    if (identifier.location != "wayland") {
+        if (readDeviceBitMask(EVIOCGKEY(0), keyState) < 0) {
+            ALOGD("Unable to query the global key state for %s: %s", path.c_str(), strerror(errno));
+        }
+        if (readDeviceBitMask(EVIOCGSW(0), swState) < 0) {
+            ALOGD("Unable to query the global switch state for %s: %s", path.c_str(), strerror(errno));
+        }
     }
 
     // Read absolute axis info and values for all available axes for the device.
diff --git a/services/inputflinger/reader/mapper/accumulator/MultiTouchMotionAccumulator.cpp b/services/inputflinger/reader/mapper/accumulator/MultiTouchMotionAccumulator.cpp
index c81661bf5..d72aeeb95 100644
--- a/services/inputflinger/reader/mapper/accumulator/MultiTouchMotionAccumulator.cpp
+++ b/services/inputflinger/reader/mapper/accumulator/MultiTouchMotionAccumulator.cpp
@@ -98,7 +98,7 @@ void MultiTouchMotionAccumulator::syncSlots(const InputDeviceContext& deviceCont
                                                    ABS_MT_TOOL_TYPE};
     const size_t numSlots = mSlots.size();
     for (int32_t axisCode : axisCodes) {
-        if (!deviceContext.hasAbsoluteAxis(axisCode)) {
+        if (!deviceContext.hasAbsoluteAxis(axisCode) || deviceContext.getDeviceIdentifier().location == "wayland") {
             continue;
         }
         const auto result = deviceContext.getMtSlotValues(axisCode, numSlots);
